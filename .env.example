# Copy to .env.local and fill in values. Never commit .env*.

# Postgres
DATABASE_URL=postgres://dsrvm:dsrvm-local@localhost:5432/dsrvm

# Redis (queues)
REDIS_URL=redis://localhost:6379

# AI providers (at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Azure OpenAI (preferredAIService=azure-openai, or AI_SERVICE_PROVIDER=azure-openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Google Gemini (preferredAIService=gemini, or AI_SERVICE_PROVIDER=gemini)
GEMINI_API_KEY=
# Microsoft Copilot via Azure OpenAI-compatible endpoint
COPILOT_API_KEY=
COPILOT_ENDPOINT=
COPILOT_DEPLOYMENT=gpt-4o-mini
# Default AI provider when a tenant has no preferredAIService set
# (azure-openai | openai | gemini | copilot | anthropic | none)
AI_SERVICE_PROVIDER=
AI_API_KEY=

# Client CMS integration (preferredCMS per tenant wins over CMS_TYPE default)
# (sharepoint | sitecore | aem | umbraco | dotnetnuke | wordpress | opencms | custom | none)
CMS_TYPE=none
CMS_API_ENDPOINT=
# Auth for the configured CMS_TYPE (bearer token preferred; basic as fallback)
CMS_API_TOKEN=
CMS_API_USERNAME=
CMS_API_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev ports (pnpm dev / staging:local). Each app uses PORT unless overridden:
#   api=8899 (primary dev entry, http://127.0.0.1:8899/health)
#   hr-automation=3002, web=3003
PORT=8899
API_PORT=8899
HR_PORT=3002
WEB_PORT=3003

# API auth (optional; if unset, auth is disabled in dev)
HR_API_TOKEN=
API_TOKEN=

# SSO (optional; each provider enables only when its keys are set)
# Redirect base, e.g. https://app.dsrvm.app
SSO_BASE_URL=http://localhost:3003
# Azure AD (Microsoft Entra ID) via OIDC
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Google Workspace via OIDC (GOOGLE_HOSTED_DOMAIN restricts sign-in to that org)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=

# Cloudflare deploy (GitHub Actions secrets; never commit real values)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare KV namespace IDs (set per env via wrangler.toml or secrets)
# KV_RUNBOOKS_ID=
