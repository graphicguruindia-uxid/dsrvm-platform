{
  "name": "@dsrvm/hr-automation",
  "version": "0.2.0",
  "description": "HR automation reviewer app: Fastify API + minimal dashboard wired to @dsrvm/hr (candidate intake, AI screening, human-in-the-loop review, audit trail)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "prettier --check src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dsrvm/ai": "workspace:*",
    "@dsrvm/hr": "workspace:*",
    "@dsrvm/telemetry": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
