{
  "name": "@dsrvm/web-app",
  "version": "0.3.0",
  "description": "Enterprise web reference architecture v0.3 reference server: Fastify API + admin console skeleton wired to @dsrvm/web (multi-tenancy, auth+RBAC+SSO, CMS, billing/usage hooks)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/serve.ts",
    "lint": "prettier --check src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dsrvm/web": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
