{
  "name": "dsrvm",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "qa:smoke": "tsx scripts/qa-smoke.mts",
    "qa": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm qa:smoke",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
